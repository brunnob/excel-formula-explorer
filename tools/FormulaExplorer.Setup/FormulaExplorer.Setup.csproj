<Project Sdk="Microsoft.NET.Sdk">

  <!-- Built by scripts\build-setup.ps1, which first builds the packed add-in (Release) that is embedded here. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>FormulaExplorerSetup</AssemblyName>
    <RootNamespace>FormulaExplorer.Setup</RootNamespace>
    <ApplicationIcon>setup.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <Product>Formula Explorer</Product>
    <!-- One self-contained exe: it must run on machines that do not have .NET yet. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <AddInXll>..\..\src\FormulaExplorer.AddIn\bin\Release\net10.0-windows\publish\FormulaExplorer64-packed.xll</AddInXll>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="$(AddInXll)" LogicalName="FormulaExplorer64.xll" />
  </ItemGroup>

  <Target Name="RequireAddInXll" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(AddInXll)')" Text="Packed add-in not found ($(AddInXll)). Run scripts\build-setup.ps1." />
  </Target>

</Project>
